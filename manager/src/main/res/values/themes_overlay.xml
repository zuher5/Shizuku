<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default dark theme: neutral dark grey tonal ladder so filled cards
         remain visually separated from the background. Pure black is
         reserved exclusively for ThemeOverlay.Black (user opt-in). -->
    <style name="ThemeOverlay">
        <item name="android:colorBackground">#1A1B21</item>
        <item name="colorSurface">#1A1B21</item>
        <item name="colorSurfaceContainerLowest">#1E1F25</item>
        <item name="colorSurfaceContainerLow">#23242B</item>
        <item name="colorSurfaceContainer">#2A2B33</item>
        <item name="colorSurfaceContainerHigh">#32333C</item>
        <item name="colorSurfaceContainerHighest">#3C3D47</item>
        <item name="colorSecondaryContainer">#2E3040</item>
    </style>

    <style name="ThemeOverlay.Black">
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorPrimaryDark">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">#121316</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">#1E2026</item>
        <item name="colorSurfaceContainer">#262832</item>
        <item name="colorSurfaceContainerHigh">#2E303C</item>
        <item name="colorSurfaceContainerHighest">#383A48</item>
        <item name="colorSecondaryContainer">#262934</item>
    </style>

    <style name="ThemeOverlay.DynamicColors.Light" parent="ThemeOverlay.Material3.DynamicColors.Light.Shizuku"/>

    <style name="ThemeOverlay.DynamicColors.Dark" parent="ThemeOverlay.Material3.DynamicColors.Dark.Shizuku"/>

</resources>
